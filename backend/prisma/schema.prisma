generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  Draft
  Pending
  Paid
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullname     String
  createdAt    DateTime  @default(now())
  invoices     Invoice[]
}

model Invoice {
  invoiceId        String        @id @default(uuid())
  invoiceNumber    String        @unique
  invoiceReference String?
  invoiceDate      DateTime      @db.Date
  dueDate          DateTime      @db.Date
  currency         String
  currencySymbol   String
  description      String?
  status           InvoiceStatus @default(Draft)

  // customer, embedded (documented choice — spec §3.2 allows either)
  customerFullname String
  customerEmail    String
  customerMobile   String?
  customerAddress  String?

  invoiceSubTotal  Decimal  @db.Decimal(12, 2)
  totalTax         Decimal  @db.Decimal(12, 2)
  totalDiscount    Decimal  @db.Decimal(12, 2) @default(0)
  totalAmount      Decimal  @db.Decimal(12, 2)
  totalPaid        Decimal  @db.Decimal(12, 2) @default(0)
  balanceAmount    Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id])

  items InvoiceItem[]

  @@index([customerFullname])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([totalAmount])
  @@index([createdBy])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  name      String
  quantity  Int
  rate      Decimal @db.Decimal(12, 2)
}
